<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PackageId>Common.Messaging</PackageId>
    <Version>1.0.0</Version>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <Description>Reusable in-app and external messaging primitives for Aegis applications.</Description>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="Common.Messaging.UnitTests/**/*.cs" />
    <EmbeddedResource Remove="Common.Messaging.UnitTests/**" />
    <None Remove="Common.Messaging.UnitTests/**" />
    <Compile Remove="Common.Messaging.Hosting/**/*.cs" />
    <EmbeddedResource Remove="Common.Messaging.Hosting/**" />
    <None Remove="Common.Messaging.Hosting/**" />
  </ItemGroup>
</Project>
